# Lab settings. Copy this file to .env (git-ignored) and uncomment what you change.
# A variable set on the command line wins over .env, for that command only: make up KAAS=1

# Set to 1 to add Kubernetes as a Service (manifests/kaas.yaml), about 2 GiB more RAM.
# Not set: keep what the lab runs (none on a new lab).
# KAAS=0

# Superphenix release to install, or "latest".
# SPX_VERSION=0.10.0

# Superphenix checkout used by `make dev-*`. A relative path starts from this folder.
# Default: the checkout this folder is in.
# SUPERPHENIX_REPO=../..

# console-ui checkout used by `make dev-console`. A relative path starts from this folder.
# Default: a console-ui checkout next to this superphenix checkout.
# CONSOLE_REPO=../../../console-ui

# kind node image. The Kubernetes version.
# KIND_NODE_IMAGE=kindest/node:v1.37.0
