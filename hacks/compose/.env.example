# Required for the docker compose setup: absolute paths to your local frontend repo checkouts.
# Copy this file to .env (cp .env.example .env) and fill these in.
AUTH_UI_PATH=/absolute/path/to/auth-ui
SPX_PANEL_PATH=/absolute/path/to/spx-panel
SUPERPHENIX_API_CONTROLLER_SECRET=CHANGEME
COMPOSE_PROFILES=backend,auth-ui,spx-panel

# ARGO_CONTROLLER_URL=http://localhost:8081/v1
# ARGO_CONTROLLER_SECRET=CHANGEME
# ARGOCD_URL=https://argocd.example.com